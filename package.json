{
  "name": "almaty-traffic-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "portfolio:bootstrap": "PYTHONPATH=src sh -c 'if [ -n \"$TRAFFIC_SIM_PYTHON\" ]; then exec \"$TRAFFIC_SIM_PYTHON\" scripts/bootstrap_portfolio.py \"$@\"; elif [ -x .venv/bin/python ]; then exec .venv/bin/python scripts/bootstrap_portfolio.py \"$@\"; else exec python3 scripts/bootstrap_portfolio.py \"$@\"; fi' --",
    "verify:release": "sh scripts/verify-public-release.sh",
    "security:scan-runtime": "sh scripts/scan-runtime-image.sh",
    "test:docs": "node tests/docs_contract.mjs",
    "lab:data": "python3 scripts/lab/build_city_graph.py && python3 scripts/lab/build_demand.py",
    "lab:calibrate": "tsx scripts/lab/calibrate.ts",
    "lab:artifacts": "tsx scripts/lab/build_artifacts.ts",
    "test:engine": "vitest run",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@vis.gl/react-maplibre": "^8.1.3",
    "maplibre-gl": "^6.12.0",
    "next": "^16.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "playwright": "1.62.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
