{
  "name": "almaty-traffic-simulation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.20.0 <21",
    "npm": ">=10.8.2 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "portfolio:bootstrap": "PYTHONPATH=src sh -c 'if [ -n \"$TRAFFIC_SIM_PYTHON\" ]; then exec \"$TRAFFIC_SIM_PYTHON\" scripts/bootstrap_portfolio.py \"$@\"; elif [ -x .venv/bin/python ]; then exec .venv/bin/python scripts/bootstrap_portfolio.py \"$@\"; else exec python3 scripts/bootstrap_portfolio.py \"$@\"; fi' --",
    "verify:release": "sh scripts/verify-public-release.sh",
    "verify:public-routes": "sh scripts/verify-public-routes.sh",
    "security:scan-runtime": "sh scripts/scan-runtime-image.sh",
    "test:docs": "node tests/docs_contract.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/extensions": "9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@vis.gl/react-maplibre": "^8.1.1",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "playwright": "1.62.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
