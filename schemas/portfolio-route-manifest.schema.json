{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almaty-mobility.local/schemas/portfolio-route-manifest.schema.json",
  "title": "Almaty Mobility portfolio route manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "claimLevel",
    "generatedAt",
    "status",
    "sourceManifest",
    "artifacts",
    "downloads",
    "aliases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "portfolio-route-manifest/v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "scenarioId": {
      "const": "abay-signal-retiming"
    },
    "claimLevel": {
      "$ref": "#/$defs/claimLevel"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "promoted"
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "portfolio.sources.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "downloads": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/download"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "dossier-html"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "dossier-json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "kpis-csv"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "run-passport-json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "procurement-index-json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "paths"],
      "properties": {
        "status": {
          "enum": ["pending", "synced", "failed"]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        }
      }
    }
  },
  "$defs": {
    "claimLevel": {
      "enum": ["demo", "proxy", "calibrated", "real-data", "procurement-ready"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.staging(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "runId",
        "logicalPath",
        "sha256",
        "bytes",
        "mediaType",
        "claimLevel"
      ],
      "properties": {
        "role": {
          "enum": [
            "dossier",
            "runPassport",
            "providers",
            "workflow",
            "procurement",
            "reproduction",
            "manifest",
            "dataReadiness",
            "procurementPack",
            "applicationPack",
            "pilotPlan"
          ]
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "logicalPath": {
          "$ref": "#/$defs/logicalPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "const": "application/json"
        },
        "claimLevel": {
          "$ref": "#/$defs/claimLevel"
        }
      }
    },
    "download": {
      "oneOf": [
        {
          "$ref": "#/$defs/dossierHtmlDownload"
        },
        {
          "$ref": "#/$defs/dossierJsonDownload"
        },
        {
          "$ref": "#/$defs/kpisCsvDownload"
        },
        {
          "$ref": "#/$defs/runPassportJsonDownload"
        },
        {
          "$ref": "#/$defs/procurementIndexJsonDownload"
        }
      ]
    },
    "downloadBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "logicalPath",
        "sha256",
        "bytes",
        "mediaType",
        "filename"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "logicalPath": {
          "$ref": "#/$defs/logicalPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mediaType": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "dossierHtmlDownload": {
      "allOf": [
        {
          "$ref": "#/$defs/downloadBase"
        },
        {
          "properties": {
            "id": {
              "const": "dossier-html"
            },
            "logicalPath": {
              "const": "reports/dossiers/abay-signal-retiming/dossier.html"
            },
            "mediaType": {
              "const": "text/html"
            },
            "filename": {
              "const": "abay-signal-retiming-dossier.html"
            }
          }
        }
      ]
    },
    "dossierJsonDownload": {
      "allOf": [
        {
          "$ref": "#/$defs/downloadBase"
        },
        {
          "properties": {
            "id": {
              "const": "dossier-json"
            },
            "logicalPath": {
              "const": "reports/dossiers/abay-signal-retiming/dossier.json"
            },
            "mediaType": {
              "const": "application/json"
            },
            "filename": {
              "const": "abay-signal-retiming-evidence.json"
            }
          }
        }
      ]
    },
    "kpisCsvDownload": {
      "allOf": [
        {
          "$ref": "#/$defs/downloadBase"
        },
        {
          "properties": {
            "id": {
              "const": "kpis-csv"
            },
            "logicalPath": {
              "const": "reports/dossiers/abay-signal-retiming/kpis.csv"
            },
            "mediaType": {
              "const": "text/csv"
            },
            "filename": {
              "const": "abay-signal-retiming-kpis.csv"
            }
          }
        }
      ]
    },
    "runPassportJsonDownload": {
      "allOf": [
        {
          "$ref": "#/$defs/downloadBase"
        },
        {
          "properties": {
            "id": {
              "const": "run-passport-json"
            },
            "logicalPath": {
              "const": "data/runs/abay-signal-retiming-run-passport.json"
            },
            "mediaType": {
              "const": "application/json"
            },
            "filename": {
              "const": "abay-signal-retiming-run-passport.json"
            }
          }
        }
      ]
    },
    "procurementIndexJsonDownload": {
      "allOf": [
        {
          "$ref": "#/$defs/downloadBase"
        },
        {
          "properties": {
            "id": {
              "const": "procurement-index-json"
            },
            "logicalPath": {
              "const": "reports/akimat/abay-signal-retiming/procurement_pack_index.json"
            },
            "mediaType": {
              "const": "application/json"
            },
            "filename": {
              "const": "abay-signal-retiming-procurement-index.json"
            }
          }
        }
      ]
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {
          "enum": [
            "dossier",
            "runPassport",
            "providers",
            "workflow",
            "procurement",
            "reproduction",
            "manifest",
            "dataReadiness",
            "procurementPack",
            "applicationPack",
            "pilotPlan"
          ]
        },
        "path": {
          "$ref": "#/$defs/logicalPath"
        }
      }
    }
  }
}
