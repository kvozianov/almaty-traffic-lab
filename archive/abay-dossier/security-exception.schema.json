{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almaty-mobility.local/schemas/security-exception.schema.json",
  "title": "Security exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "tool", "advisory", "packageOrImage", "severity", "reachability",
    "owner", "approvedBy", "approvedAt", "expiresAt", "compensatingControls", "rationale"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "advisory": { "type": "string", "minLength": 1 },
    "packageOrImage": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["low", "moderate", "high", "critical"] },
    "reachability": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "compensatingControls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rationale": { "type": "string", "minLength": 1 }
  }
}
